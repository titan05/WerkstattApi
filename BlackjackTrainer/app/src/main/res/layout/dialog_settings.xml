<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TISCHREGELN"
            android:textColor="#7A7A7A"
            android:textSize="11sp"
            android:letterSpacing="0.14"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Anzahl Decks"
                android:textColor="#1A1A1A"
                android:textSize="15sp" />

            <Spinner
                android:id="@+id/spinnerDecks"
                android:layout_width="110dp"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swH17"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Dealer zieht bei Soft 17 (H17)"
            android:textColor="#1A1A1A"
            android:textSize="15sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swBj32"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Blackjack zahlt 3:2 (sonst 6:5)"
            android:textColor="#1A1A1A"
            android:textSize="15sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swDas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Verdoppeln nach Teilen (DAS)"
            android:textColor="#1A1A1A"
            android:textSize="15sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swSurrender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Aufgeben erlaubt (Late Surrender)"
            android:textColor="#1A1A1A"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#22000000" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TRAINING"
            android:textColor="#7A7A7A"
            android:textSize="11sp"
            android:letterSpacing="0.14"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swAutoTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Tipp automatisch anzeigen"
            android:textColor="#1A1A1A"
            android:textSize="15sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swWarn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Warnen, wenn ich vom Tipp abweiche"
            android:textColor="#1A1A1A"
            android:textSize="15sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swCounting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Kartenzählen üben (Hi-Lo)"
            android:textColor="#1A1A1A"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Zeigt Running Count und True Count an und passt die Tipps mit den Abweichungen der „Illustrious 18“ an."
            android:textColor="#7A7A7A"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#22000000" />

        <Button
            android:id="@+id/btnResetStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Statistik zurücksetzen"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnResetBankroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Guthaben auf 1.000 zurücksetzen"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
