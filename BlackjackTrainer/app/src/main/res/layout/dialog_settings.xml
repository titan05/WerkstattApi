<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TISCHREGELN"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:letterSpacing="0.14"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Anzahl Decks"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <!-- Knopfreihe statt Auswahlliste: Deren Aufklappmenü würde die
             Farben des Dialogs nicht erben. -->
        <LinearLayout
            android:id="@+id/deckPicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swH17"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Dealer zieht bei Soft 17 (H17)"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swBj32"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Blackjack zahlt 3:2 (sonst 6:5)"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swDas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Verdoppeln nach Teilen (DAS)"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swSurrender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Aufgeben erlaubt (Late Surrender)"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#33FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TRAINING"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:letterSpacing="0.14"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swAutoTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Tipp automatisch anzeigen"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swWarn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Warnen, wenn ich vom Tipp abweiche"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#33FFFFFF" />

        <Button
            android:id="@+id/btnResetStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Statistik zurücksetzen"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnResetBankroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Guthaben auf 1.000 zurücksetzen"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
