<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="10dp">

    <!-- Kopfzeile: eine Zeile, mehr braucht es hier nicht -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE"
            android:textColor="@color/gold"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/liveRules"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/liveSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/btn_outline"
            android:text="⚙"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:stateListAnimator="@null"
            android:contentDescription="Einstellungen" />
    </LinearLayout>

    <!-- Die Entscheidung: farbige Tafel, Farbe wie in der Strategietabelle -->
    <LinearLayout
        android:id="@+id/advicePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/adviceAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/adviceReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#E8FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/adviceInsurance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#D6FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Wie am Tisch: Dealer oben, eigene Hand darunter.
         Das hervorgehobene Feld bekommt die Eingabe, Antippen wechselt. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/dealerSlotBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/hand_idle"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/dealerSlotLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEALER"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <FrameLayout
                android:id="@+id/dealerSlot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:minWidth="62dp"
                android:minHeight="88dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/playerHandsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

    </LinearLayout>

    <!-- Ansage, wohin der nächste Tastendruck geht -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/keypadPrompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/gold"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Das Tastenfeld: immer an derselben Stelle, große Flächen -->
    <LinearLayout
        android:id="@+id/keypadRow1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/keypadRow2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUndoCard"
            android:layout_width="0dp"
            android:layout_height="74dp"
            android:layout_weight="1"
            android:background="@drawable/btn_outline"
            android:text="Zurück"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:stateListAnimator="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSplit"
            android:layout_width="0dp"
            android:layout_height="74dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_outline"
            android:text="Teilen"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:stateListAnimator="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNewRound"
            android:layout_width="0dp"
            android:layout_height="74dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_gold"
            android:text="Neue Runde"
            android:textAllCaps="false"
            android:textColor="#0C2A18"
            android:textSize="19sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>
