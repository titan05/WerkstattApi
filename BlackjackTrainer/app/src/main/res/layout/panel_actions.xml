<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelActions"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/panel_round"
    android:padding="10dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnHit"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/btn_light"
            android:text="Karte"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_colors"
            android:textSize="15sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStand"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_light"
            android:text="Stehen"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_colors"
            android:textSize="15sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDouble"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/btn_light"
            android:text="Doppeln"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_colors"
            android:textSize="13sp"
            android:stateListAnimator="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSplit"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_light"
            android:text="Teilen"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_colors"
            android:textSize="13sp"
            android:stateListAnimator="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSurrender"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_light"
            android:text="Aufgeben"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_colors"
            android:textSize="13sp"
            android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>
