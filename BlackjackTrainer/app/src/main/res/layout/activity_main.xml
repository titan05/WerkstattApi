<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="10dp">

    <!-- Kopfzeile: Guthaben, Count, Menü -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/panel_round"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bankrollLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GUTHABEN"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/bankrollValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.000"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/countBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/badge_round"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/countLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RC / TC"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/countValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 0.0"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnChart"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/btn_outline"
            android:text="📋"
            android:textSize="17sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:contentDescription="Strategietabelle" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSettings"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_outline"
            android:text="⚙"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:padding="0dp"
            android:minWidth="0dp"
            android:contentDescription="Einstellungen" />
    </LinearLayout>

    <!-- Spielfeld, mit dem Schlitten oben rechts -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/dealerHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="DEALER"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:letterSpacing="0.2" />

        <LinearLayout
            android:id="@+id/dealerCards"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="96dp"
            android:orientation="horizontal"
            android:gravity="center" />

        <TextView
            android:id="@+id/dealerTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/badge_round"
            android:paddingHorizontal="12dp"
            android:paddingVertical="2dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="22dp"
            android:gravity="center"
            android:text="Setze deinen Einsatz"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <TextView
            android:id="@+id/playerHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="DEIN BLATT"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:letterSpacing="0.2" />

        <HorizontalScrollView
            android:id="@+id/playerScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/playerHands"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center" />
        </HorizontalScrollView>
    </LinearLayout>

        <LinearLayout
            android:id="@+id/shoeBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <View
                android:id="@+id/shoeStack"
                android:layout_width="46dp"
                android:layout_height="62dp"
                android:background="@drawable/shoe_stack" />

            <TextView
                android:id="@+id/shoeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Tipp-Panel -->
    <LinearLayout
        android:id="@+id/tipPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/tip_panel"
        android:paddingHorizontal="10dp"
        android:paddingVertical="7dp"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_gold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="1dp"
                android:text="TIPP"
                android:textColor="#0C2A18"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tipAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="—"
                android:textColor="@color/gold"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRevealTip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/btn_outline"
                android:text="Zeigen"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"
                android:minWidth="0dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tipReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Antippen, um die Empfehlung zu sehen."
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tipCountNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/push"
            android:textSize="11sp"
            android:textStyle="italic"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Steuerung -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <include android:id="@+id/incBetting" layout="@layout/panel_betting" />
        <include android:id="@+id/incActions" layout="@layout/panel_actions" />
        <include android:id="@+id/incInsurance" layout="@layout/panel_insurance" />
        <include android:id="@+id/incRoundOver" layout="@layout/panel_roundover" />
        <include android:id="@+id/incDealer" layout="@layout/panel_dealer" />
    </FrameLayout>

    <TextView
        android:id="@+id/statsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text=""
        android:textColor="@color/text_muted"
        android:textSize="11sp" />
</LinearLayout>
