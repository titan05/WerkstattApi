<?xml version="1.0" encoding="utf-8"?>
<!-- Hervorgehobener Button für die empfohlene Aktion: zwei Gold-Höfe um einen
     hellen Kern. Zusammen mit dem Puls-Animator wirkt das wie ein Glühen. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#40E8B830" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape>
                    <solid android:color="#73E8B830" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
                <shape>
                    <solid android:color="#EFE3BE" />
                    <corners android:radius="11dp" />
                    <stroke android:width="2dp" android:color="@color/gold" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#3DE8B830" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape>
                    <solid android:color="#75E8B830" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
                <shape>
                    <solid android:color="#FFFDF3" />
                    <corners android:radius="11dp" />
                    <stroke android:width="2dp" android:color="@color/gold" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
