<?xml version="1.0" encoding="utf-8"?>
<!-- Kartenschlitten: drei versetzte Kartenrücken als kleiner Stapel. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="0dp" android:top="7dp" android:right="9dp" android:bottom="0dp">
        <shape>
            <solid android:color="#12294F" />
            <corners android:radius="5dp" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
    <item android:left="5dp" android:top="4dp" android:right="5dp" android:bottom="3dp">
        <shape>
            <solid android:color="#1B3A6B" />
            <corners android:radius="5dp" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
    <item android:left="9dp" android:top="0dp" android:right="0dp" android:bottom="7dp">
        <shape>
            <solid android:color="#2E5FA8" />
            <corners android:radius="5dp" />
            <stroke android:width="1dp" android:color="#73FFFFFF" />
        </shape>
    </item>
</layer-list>
